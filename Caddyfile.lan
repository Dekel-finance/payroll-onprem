# The default certificate: Caddy's own CA.
#
# A bureau's server has a name like `payroll.office.local` or no name at all,
# just an address on the LAN. Let's Encrypt cannot issue for either — it has to
# reach the host from the internet, which is the whole thing an on-prem install
# is avoiding. So Caddy runs a small certificate authority of its own and issues
# from it.
#
# That costs one step, once: each staff machine has to trust the CA, or the
# browser shows a warning. The certificate is written to the `caddy-data`
# volume; export it with
#
#     docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt .
#
# and install it as a trusted root. The README has the per-platform steps.
#
# The alternative is plain HTTP, and plain HTTP does not work here: all three
# apps mark the session cookie `Secure` in production, and a browser silently
# discards a Secure cookie that arrived over http://. The login page would take
# the password, redirect, and come back to itself for ever.

{
	# Nothing is fetched from a public CA in this mode, so the ACME machinery is
	# left switched off rather than failing in the background every few minutes.
	auto_https disable_redirects
}

https://{$SITE_ADDRESS}:{$CONSOLE_PORT} {
	tls internal
	reverse_proxy console:3201 {
	# Hold the request instead of failing it while a container is being replaced.
	#
	# Measured: recreating one app container costs 1.6 seconds during which Caddy
	# has nothing to talk to and answers 502. That is short, and 502 is still the
	# wrong answer — an unattended update should not put an error in front of
	# somebody who was mid-task. Caddy retries for up to 30s at 250ms intervals,
	# so the request that lands in the gap simply takes about two seconds longer
	# and then succeeds.
	#
	# Only retried when NO response was received, which is Caddy's default and
	# the reason this is safe for a POST as well: a request the app already began
	# answering is never sent twice.
	lb_try_duration 30s
	lb_try_interval 250ms
}
}

https://{$SITE_ADDRESS}:{$ADMIN_PORT} {
	tls internal
	reverse_proxy admin:3300 {
	# Hold the request instead of failing it while a container is being replaced.
	#
	# Measured: recreating one app container costs 1.6 seconds during which Caddy
	# has nothing to talk to and answers 502. That is short, and 502 is still the
	# wrong answer — an unattended update should not put an error in front of
	# somebody who was mid-task. Caddy retries for up to 30s at 250ms intervals,
	# so the request that lands in the gap simply takes about two seconds longer
	# and then succeeds.
	#
	# Only retried when NO response was received, which is Caddy's default and
	# the reason this is safe for a POST as well: a request the app already began
	# answering is never sent twice.
	lb_try_duration 30s
	lb_try_interval 250ms
}
}

# The same admin app, reached over an SSH tunnel.
#
# The host port is bound to loopback (see `docker-compose.yml`), so this block
# answers only through `ssh -L $ADMIN_PORT:127.0.0.1:$ADMIN_PORT <host>`, where
# the browser sends `Host: localhost` and the block above — which matches
# SITE_ADDRESS — does not apply. Caddy's own certificate, always: a tunnel
# endpoint has no public name to issue for, so staff click through the warning.
https://:{$ADMIN_PORT} {
	tls internal
	reverse_proxy admin:3300 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
