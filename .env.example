# The on-prem bundle's configuration. Copy to `.env` and fill in.
#
#     cp .env.example .env
#     docker compose up -d --build
#
# Compose refuses to start if any of the four required values below is missing,
# rather than booting a stack with an open gateway or an unidentifiable install.

# ── Required ──────────────────────────────────────────────────────────────────

# The hostname your staff will type, e.g. `payroll.acme.local`. Caddy issues the
# certificate for exactly this name, the apps mark their session cookie Secure,
# and a browser silently DISCARDS such a cookie over plain http:// — so getting
# this wrong looks like a login form that accepts the password and bounces
# straight back to itself.
#
# Leave the scheme and the port off. `localhost` works for a first look and
# gives a certificate from Caddy's own CA rather than a public one.
SITE_ADDRESS=

# The bearer the console, console-v2 and admin present to the gateway. It is
# ALSO what they are given as their "vendor key" — they hold no real Anthropic or
# Interfaze credential, so a compromised console cannot spend the model budget
# or send anything that skips the audit.
#   openssl rand -hex 32
GATEWAY_TOKEN=

# Shared secret between console-v2 and admin for ticket threads and attachment
# previews (apps/console-v2/lib/attachments.ts). Must match on both, which the
# compose file arranges. Unset = previews fail closed.
#   openssl rand -hex 32
INTERNAL_TOKEN=

# Who this install is, in the fleet. An opaque handle, not a customer name —
# it appears in every metrics row we receive.
METRICS_INSTALL_ID=

# The ת"ז keyring (PAY-112) — `<version>:<base64url of 64 random bytes>`, comma
# separated. The first 32 bytes are the blind-index pepper, the last 32 the
# AES key. Must NOT live where the database lives: a dump plus this value
# recovers every identity number, and a dump without it recovers none.
#
# **Required by every app in the bundle** — the console lists employees and the
# first one it touches throws without it.
#
#   node -e "console.log('v1:'+require('crypto').randomBytes(64).toString('base64url'))"
NATIONAL_ID_KEYS=
# Which version new writes use. Blank = the last one listed. Only ever changed
# as step 2 of the four-step rotation in packages/core/src/national-id.ts.
NATIONAL_ID_ACTIVE_KEY=

# The three session-signing keys — one per app that signs a cookie.
#
# Leave them blank and each app derives its own from `INTERNAL_TOKEN` (or
# `GATEWAY_TOKEN`), which is unique to this install: that is what keeps an
# install created before these existed from being locked out. Set them to pin a
# key that survives rotating the tokens above; changing one signs everybody out
# of that app and nothing more.
#
# What they must NEVER be is unset on an app with no install secret either — the
# apps refuse to start rather than fall back to the published constant they used
# to use.
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
SESSION_SECRET=

# Bearer the console presents to the payroll connector, when this install uses
# one. The connector is OUR infrastructure — a Windows desktop driven over RDP
# on a VM we run — so it is not in this bundle; the console reaches it over
# HTTPS by URL and this token, exactly as the hosted deployment does. Blank
# unless we have told you otherwise.
MICHPAL_WORKER_URL=
WORKER_TOKEN=

# What the scheduler presents to the scheduled routes. Must match what the
# apps expect (they check `Authorization: Bearer $CRON_SECRET`).
#
# **This one is load-bearing.** Nothing periodic runs itself: each job is a
# route something has to call. In the hosted deployment that caller is Vercel
# Cron; on-prem it is the `scheduler` container. Get this wrong and the monitor
# and the policy check stop running with every health check still green.
#   openssl rand -hex 32
CRON_SECRET=

# Which scheduled jobs run. Blank = the sensible on-prem set. `all` adds the
# optional ones; or name them: admin.monitor,console.policyVerify
SCHEDULER_JOBS=

# Which kind of install this is. `onprem` makes every storage decision local and
# treats the gateway as mandatory; `cloud` is the hosted default. Set once —
# the individual settings derive from it (packages/core/src/deploy-target.ts).
DEPLOY_TARGET=onprem

# ── The model vendors ─────────────────────────────────────────────────────────
#
# These live ONLY in the gateway container. Leave one blank to disable that
# vendor: calls to it then refuse with NOT_CONFIGURED naming the variable,
# which is the supported way to run an install that talks to one vendor only.
#
# docs/on-prem-architecture.md §6.2 is the argument for a third option — a key
# on the CUSTOMER's own Anthropic or Bedrock account. Nothing here prevents
# that; it is their key in their file, and their data agreement rather than ours.
ANTHROPIC_API_KEY=
INTERFAZE_API_KEY=

# ── The model broker ──────────────────────────────────────────────────────────
#
# Prompts and vendor keys live in OUR cloud, never on this machine. The apps in
# this bundle call the gateway (below), the gateway forwards to the broker, and
# the broker assembles the real prompt and calls the provider. See
# docs/onprem-model-broker.md.
#
# Nothing here is a vendor credential: the token identifies THIS install to us,
# and can be switched off our side without touching this machine.
#
# **You do not need to set the URL** — the broker's address is compiled into the
# image, the same way the control plane's is. Leave it blank. Set it to `off`
# only to disable model features on purpose; the install then runs everything
# deterministic and refuses the rest with a readable message.
#
# The TOKEN you do need, and we give it to you with the install id.
MODEL_BROKER_URL=
MODEL_BROKER_TOKEN=

# ── Gateway policy ────────────────────────────────────────────────────────────

# enforce  pseudonymize before sending. The default and the only setting that
#          protects anything.
# report   pseudonymize, record what WOULD have been hidden, and forward the
#          original. For the first week of an install, to see the numbers before
#          changing behaviour. It does not protect traffic and says so on boot.
# off      no pseudonymization at all.
GATEWAY_MODE=enforce

# What is hidden. `money` is available and deliberately not on by default:
# document extraction has to read amounts, and an amount with no name attached
# to it is not identifying. See packages/core/src/pseudonymize.ts.
#   id · email · phone · person · org · money
GATEWAY_KINDS=email,id,phone,person,org

# What to do with a request carrying a whole document (a payslip PDF, a scanned
# ת.ז.). A text pseudonymizer cannot read into base64, so those bytes would
# cross the boundary intact.
#
# block  refuse the request with a readable Hebrew error. The default.
# allow  forward the document whole. A real choice a bureau can make — but make
#        it knowingly: this is the one setting that sends unredacted payroll
#        documents to a third party.
GATEWAY_ATTACHMENTS=block

# ── Metrics ───────────────────────────────────────────────────────────────────

# **You do not need to set the URL.** The control plane's address is compiled
# into the image, so an install reports to the fleet by default — an install we
# cannot see is our problem to notice, not yours to configure.
#
# What you DO need is the token: we register the install id above and give you
# the bearer it shows once. Without it every push is refused with 401, and the
# metrics container says exactly that at boot.
#
# To opt out on purpose, set it to the word `off` — not to a blank, which is
# indistinguishable from never having filled it in. The install then keeps
# working and simply never appears in the fleet.
METRICS_CONTROL_PLANE_URL=
METRICS_INSTALL_TOKEN=

# ── Mail ──────────────────────────────────────────────────────────────────────
#
# This install has no inbound path at any perimeter — no port, no firewall rule,
# no exception. That is the thing being sold, not an oversight, so a mail
# provider cannot deliver to it and a webhook has nowhere to land.
#
# Instead the gateway COLLECTS. It long-polls the control plane above for mail
# parked there for this install, opens each delivery with the private key below,
# and hands it to the console — which runs the same code the hosted webhook
# runs, so a month opened here is the same month. A reply goes back out the same
# door: the install describes the message, we send it under the bureau's own
# verified domain, and no Resend credential ever sits on this machine.
#
# `off` (the default) means this install receives no email at all, and any reply
# it tries to send will fail. The gateway says so on every boot.
MAIL_INBOUND_MODE=off

# Generate with: node deploy/onprem/generate-mail-key.mjs
#
# We never hold this half and never see it. The gateway derives the public key
# from it and publishes that at boot, so the two halves are never in one place —
# which is what makes "mail parked on our side cannot be read by us" a fact
# about the arrangement rather than a promise. Lose it and every parked delivery
# becomes permanently unreadable.
MAIL_INSTALL_PRIVATE_KEY=

# How long one poll waits before returning empty. MUST stay under 300 seconds:
# Node's fetch aborts a request that has waited that long for response HEADERS,
# and a long poll is exactly such a request. 25 is far from the cliff and
# survives every intermediate proxy's idle timeout.
MAIL_RELAY_POLL_WAIT_SEC=25

# ── The fleet dashboard (Better Stack) ────────────────────────────────────────
#
# One source holds both fleets. The hosted deployment pushes the same rollup,
# built by the same function, tagged `cloud` instead of `onprem` — so every
# question that is really a comparison ("is the gateway slower on customer
# hardware?") is one query rather than two.
#
# It ships the SAME payload the control-plane push sends, through the SAME
# guard: counts, codes, hashes and timestamps, and nothing that has the shape of
# free text. `GET /snapshot` on this service shows the operator exactly what
# leaves. Leave both blank for an install that reports nothing.
#
#   Better Stack → Telemetry → Sources → your source → "Ingesting host"
BETTERSTACK_INGEST_HOST=
BETTERSTACK_SOURCE_TOKEN=

# A Better Stack Uptime heartbeat, pinged only after a rollup that got out.
#
# This is the half telemetry cannot do: an install that dies sends no events,
# and no events looks exactly like a quiet week. With a heartbeat, silence is
# what alerts.
BETTERSTACK_HEARTBEAT_URL=

# Salt for hashing client ids before they are reported, so the control plane
# cannot join two bureaus' clients. If unset, a random one is generated at every
# boot — safe, but per-client series reset on each restart.
#   openssl rand -hex 32
METRICS_HASH_SALT=

# ── Ports and storage ─────────────────────────────────────────────────────────

MONGODB_DB=payroll

# The port your staff reach the console on. 443 means they type
# `https://payroll.acme.local` with nothing after it, which is what you want on
# a machine that serves one application. Change it only if something else on
# this host already holds 443.
CONSOLE_PORT=443

# The console's own port INSIDE the container. Not published, and not something
# to change — Caddy proxies to it.
CONSOLE_V2_PORT=3201

ADMIN_PORT=3300

# Which interface the admin port is published on.
#
# `127.0.0.1` (the default) means the admin app runs and every service that
# talks to it over the internal network works exactly as before, but no browser
# on your network can open it. That is deliberate: the admin app is the
# supplier's backoffice, not part of the product — reach it, when support asks
# you to, with
#
#     ssh -L 3300:127.0.0.1:3300 <this host>      then https://localhost:3300
#
# Set `0.0.0.0` only if you have been told to.
ADMIN_BIND=127.0.0.1

# Where Mongo can write dumps for the bureau's own backup regime to collect.
BACKUP_DIR=./backups

# ── Updates ───────────────────────────────────────────────────────────────────

# Which channel this install follows.
#
#   stable   the release we have blessed. Moves when we move it, which is what
#            makes unattended updating safe — you are pinned to our judgement
#            rather than to whatever built last.
#   1.0.0    an exact version. Never moves, so automatic updates never fire;
#            choose this if you want to decide every upgrade yourself.
#   latest   whatever built most recently. Not recommended on a box you cannot
#            watch — docs/on-prem-architecture.md §6.4.
BUNDLE_VERSION=stable

# How often to check the registry, in seconds. Ten minutes.
AUTO_UPDATE_INTERVAL=600

# `true` reports what an update WOULD do and changes nothing — the setting for
# the first weeks of an install, or for a site that schedules its own windows.
AUTO_UPDATE_MONITOR_ONLY=false

